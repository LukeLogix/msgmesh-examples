# MsgMesh chat-web config — copy to .env and fill in your values.
# .env is excluded by .gitignore; do not commit it. Rebuild / restart the server after changes.
#
# This template uses a token-broker by default: no long-lived key in the frontend. The key lives
# only in the "backend" section below; server.js uses it to trade the platform for short-lived,
# scoped-down tokens for the frontend. The TOPIC in both sections must match.

# ── Backend (used by server.js; never enters the frontend bundle) ─────────────
# API key — must be able to both publish and subscribe to the topic below (used to mint
# short-lived tokens). Lives only in this backend, never reaches the browser.
MSGMESH_API_KEY=replace-me
# Control-plane address: the token-minting POST /v1/tokens hits this. All three service addresses in
# this file are the same: https://msgmesh-api.alderflux.com — keep them as is.
MSGMESH_CONTROL_PLANE_URL=https://msgmesh-api.alderflux.com
# Chat topic (same one for send and receive; must match the frontend's VITE_MSGMESH_TOPIC).
MSGMESH_TOPIC=chat.lobby
# Multi-room isolation (optional): the allow-set of rooms this user may access, comma-separated.
# When set, minted tokens are scoped down to these rooms — the token can only publish/subscribe to
# them; overreach gets a 403 from the platform (true isolation). Empty/removed = no room
# restriction (a single lobby).
# Must match the frontend's VITE_MSGMESH_ROOMS (the frontend only draws the menu; the real
# authorization boundary is this backend token's rooms).
MSGMESH_ROOMS=lobby,support,random
# Port the token-broker listens on (server.js serves both /api/token and the dist/ static frontend).
PORT=8787
# Interface the token-broker listens on. 127.0.0.1 = this machine only. /api/token has no login of
# its own — anyone who can reach it gets tokens minted with your key — so widen it (e.g. 0.0.0.0)
# only when the broker sits behind your own authentication.
BIND_HOST=127.0.0.1

# ── Frontend (the VITE_ prefix gets bundled; all non-sensitive, no long-lived key) ──────
# Send/receive service address (same https://msgmesh-api.alderflux.com as above).
VITE_MSGMESH_GATEWAY_URL=https://msgmesh-api.alderflux.com
# Realtime service address (both SSE streaming and WebSocket hit this; same address).
VITE_MSGMESH_REALTIME_URL=https://msgmesh-api.alderflux.com
# Chat topic (must match the backend's MSGMESH_TOPIC).
VITE_MSGMESH_TOPIC=chat.lobby
# Room menu list (comma-separated; frontend UI only, must match the backend's MSGMESH_ROOMS).
# Empty = no menu, a single lobby.
VITE_MSGMESH_ROOMS=lobby,support,random
