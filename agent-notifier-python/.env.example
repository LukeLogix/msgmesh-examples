# MsgMesh connection config — copy to .env and fill in. .env is excluded by .gitignore; do not commit it.
# main.py reads this file itself when it starts (one KEY=VALUE per line; no extra package needed).

# Receiving goes through the gateway. MsgMesh's service address is https://msgmesh-api.alderflux.com — keep it as is.
MSGMESH_GATEWAY_URL=https://msgmesh-api.alderflux.com

# API key — receiving needs a key with the consumer (or subscribe) capability. Keep it in .env only; do not commit.
MSGMESH_API_KEY=replace-me

# The topic to watch and the consumer group (multiple instances in the same group share the messages).
MSGMESH_TOPIC=orders
MSGMESH_GROUP=agent-notifier-python
